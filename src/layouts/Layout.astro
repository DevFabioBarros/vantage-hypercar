---
import '../styles/global.css';

const {
	title = 'VANTAGE — Hypercars feitos para ir além',
	description = 'Conheça a VANTAGE: design escultural, engenharia extrema e uma coleção de hypercars feita em séries limitadas.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0b0d0f" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="VANTAGE" />
		<meta property="og:locale" content="pt_BR" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<span class="custom-cursor" data-custom-cursor aria-hidden="true"></span>
		<script src="../scripts/page.js"></script>
	</body>
</html>
