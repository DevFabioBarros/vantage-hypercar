---
import { getImage } from 'astro:assets';
import sharePhoto from '../assets/images/vantage/hero.jpg';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const {
	title = 'VANTAGE — Hypercars feitos para ir além',
	description = 'Conheça a VANTAGE: design escultural, engenharia extrema e uma coleção de hypercars feita em séries limitadas.',
} = Astro.props;

const socialImage = await getImage({
  src: sharePhoto,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 85,
});
const socialImageUrl = Astro.site
  ? new URL(socialImage.src, Astro.site).href
  : socialImage.src;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0b0d0f" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="VANTAGE" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Hypercar VANTAGE em preto ônix diante de uma estrada costeira ao amanhecer" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<span class="custom-cursor" data-custom-cursor aria-hidden="true"></span>
		<script src="../scripts/page.js"></script>
	</body>
</html>
